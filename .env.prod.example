# Copy to .env.prod on the server and fill in real secrets. Used by docker-compose.prod.yml (api).
# DATABASE_URL is set by the compose file (app role); don't put it here.

APP_ENV=production
HTTP_PORT=8080

# Superuser password for Postgres + migrations. Use a long random string.
DB_PASSWORD=CHANGE_ME_long_random

# Migrations run inside compose as the superuser; this is only used if you run make targets manually.
MIGRATE_DATABASE_URL=postgres://ssp:CHANGE_ME_long_random@postgres:5432/ssp?sslmode=disable

# JWT — generate a long random secret: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=staydy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram bot (student retention). Leave blank to disable the poller.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Gemini (AI advisor).
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# CORS — the browser origins allowed to call the API. MUST list the real frontend domains.
CORS_ORIGINS=https://staydy.uz,https://app.staydy.uz,https://admin.staydy.uz
