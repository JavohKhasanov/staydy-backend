# Copy to .env and fill in. Loaded into the process env by config.Load (godotenv) and by
# docker compose. config.yml (optional) overrides nothing — env always wins.
APP_ENV=development
HTTP_PORT=8087
# Comma-separated allowed CORS origins; "*" for local dev, lock down for prod.
CORS_ORIGINS=*
LOG_LEVEL=info

# Postgres. The app connects as the non-superuser "app" role so RLS is enforced
# (superusers/owners bypass RLS); migrations run as "ssp". Host "postgres" in compose.
DATABASE_URL=postgres://app:app@localhost:5432/ssp?sslmode=disable
MIGRATE_DATABASE_URL=postgres://ssp:ssp@localhost:5432/ssp?sslmode=disable

# Auth. JWT_SECRET must be long + random — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_ISSUER=student-success
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram (single platform bot + deep-link onboarding) — leave blank until built.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI retention advisor (external LLM).
GEMINI_API_KEY=

# Superadmin (platform owner). Set both to seed the platform-owner account on boot (idempotent).
# Logs in via POST /api/v1/admin/login (no center slug). Leave blank to skip.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=Super Admin
